# Copy to .env and fill in real values. .env is gitignored.

# FastAPI JWT signing key. Must be a strong random string in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
KUANT_API_SECRET_KEY=replace-with-strong-random-string

# User credentials as `username:sha256_hash` pairs, comma-separated.
# Hash a password with: python -c "import hashlib; print(hashlib.sha256(b'yourpass').hexdigest())"
KUANT_API_USERS=alice:5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8

# Database / cache (optional depending on deployment)
# DATABASE_URL=postgresql://user:pass@host:5432/kuant
# REDIS_URL=redis://localhost:6379/0

# WRDS credentials (for routers that pull CRSP / Compustat)
# WRDS_USERNAME=your_wrds_username
# WRDS_PASSWORD=your_wrds_password

# Alpaca credentials (only needed for live-trading routers)
# ALPACA_API_KEY=your_alpaca_key
# ALPACA_SECRET_KEY=your_alpaca_secret
# APCA_API_BASE_URL=https://paper-api.alpaca.markets
